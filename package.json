{
  "name": "eql-parse",
  "version": "1.6.2",
  "type": "module",
  "description": "Parser DPS en tiempo real para EverQuest Legends — <SPAIN> Guild",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "calibrate": "node bin/calibrate.js",
    "store:check": "node bin/store-check.js",
    "store:rebuild": "node bin/store-rebuild.js",
    "live": "node bin/live.js",
    "test": "node test/smoke.js && node test/stances.js && node test/bridge.js && node test/store.js && node test/combat.js && node test/survival.js && node test/zones.js && node test/foes.js && node test/encyclopedia.js && node test/rebuild.js && node test/classes.js && node test/trios.js && node test/loot.js && node test/curacion.js && node test/dificultades.js && node test/mascotas.js && node test/share.js && node test/raid.js",
    "dist": "electron-builder --win --x64",
    "enc:rebuild": "node bin/enc-rebuild.js"
  },
  "build": {
    "appId": "dev.miguelangelfernandez.eqlparse",
    "productName": "EQL Parse SPAIN Guild",
    "files": [
      "electron/**",
      "src/**",
      "ui/**",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EQL Parse SPAIN",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "asar": false,
    "artifactName": "EQL-Parse-SPAIN-${version}-setup.${ext}"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Miguel Ángel Fernández"
}
